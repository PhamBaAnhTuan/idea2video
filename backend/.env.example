# Gemini API key from Google AI Studio
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=120

# VieNeu-TTS v3 Turbo
VIENEU_VOICE=Hải Đăng
# onnx = CPU; PyTorch auto/GPU mode can be selected when CUDA dependencies are installed
VIENEU_BACKEND=onnx

# Local Whisper ASR returns word-level timestamps from audio; no hosted STT API or NVIDIA GPU required
ALIGNMENT_REPO_DIR=../vendor/speech-to-subtitle
# Options: whisper (local/free), mai (OpenRouter API), forced_alignment (align script locally)
STT_BACKEND=whisper
# Whisper model sizes: tiny, base, small, medium, large-v3. First use downloads the model.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=vi
# Optional, only needed when STT_BACKEND=mai
OPENROUTER_API_KEY=PASTE_YOUR_OPENROUTER_API_KEY_HERE
MAI_MODEL=microsoft/mai-transcribe-2
MAI_LANGUAGE=vi
MAI_WORKERS=2
# Optional: device for STT_BACKEND=forced_alignment (requires matching Torch/Torchaudio)
ALIGNMENT_DEVICE=cpu
ALIGNMENT_WINDOW_SEC=1500

FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
NODE_BIN=node
SCENE_GAP_SECONDS=0.18
WEB_ORIGIN=http://127.0.0.1:5173
